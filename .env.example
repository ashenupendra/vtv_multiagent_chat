GOOGLE_API_KEY=
GOOGLE_TEXT_MODEL=gemini-3.5-flash
GOOGLE_LIVE_MODEL=gemini-live-2.5-flash-preview
GOOGLE_EMBEDDING_MODEL=gemini-embedding-2
GOOGLE_EMBEDDING_DIMENSIONS=768
GOOGLE_TTS_VOICE=en-US-Chirp3-HD-Kore
GOOGLE_STT_MODEL=chirp_3
IRA_ENV=local
IRA_LOG_LEVEL=INFO
IRA_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
IRA_DEFAULT_AGENT_NAME=ira-default
RAG_PROVIDER=chroma
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_PREFIX=ira
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_USE_SSL=false
CHROMA_ALLOW_STUB_FALLBACK=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ira-orchestrator
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=change-me
ADMIN_TOKEN_SECRET=ira-local-dev-secret
ADMIN_TOKEN_TTL_SECONDS=3600
ADMIN_TOKEN_ISSUER=ira-orchestrator
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Per-client-IP limit on the public chat/route/login endpoints (protects
# against abuse/cost once these are reachable from the internet).
RATE_LIMIT_REQUESTS_PER_MINUTE=30
# Telegram Text Chat integration (optional). Get the bot token from
# @BotFather. TELEGRAM_WEBSITE_ID selects which onboarded website's
# knowledge base/prompt the bot answers from (single bot = single website).
# After deploying, register the webhook once:
#   curl -X POST "https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/setWebhook" \
#     -d "url=https://<your-public-orchestrator-url>/api/telegram/webhook" \
#     -d "secret_token=<TELEGRAM_WEBHOOK_SECRET>"
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBSITE_ID=
# Production only: the public domain Caddy should get an HTTPS cert for and
# reverse-proxy to the orchestrator. DNS for this domain must already point
# at the server's IP before starting the caddy service. Not used in local
# dev (see docker-compose.prod.yml).
PUBLIC_DOMAIN=
